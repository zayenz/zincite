% Direct ordering control: compiler profiles can drop array definition metadata.
var int: x1;
var int: x2;
var int: x3;
array[1..3] of var int: input = [x1,x2,x3];
var int: y1 ::is_defined_var;
var int: y2 ::is_defined_var;
var int: y3 ::is_defined_var;
array[1..3] of var int: sorted = [y1,y2,y3];
var int: p1 ::is_defined_var;
var int: p2 ::is_defined_var;
var int: p3 ::is_defined_var;
array[1..3] of var int: permutation = [p1,p2,p3];
var int: first_min ::is_defined_var;
var int: any_min ::is_defined_var;
var int: minimum ::is_defined_var;
var bool: member ::is_defined_var;
var bool: b1 ::is_defined_var;
var bool: b2 ::is_defined_var;
var bool: b3 ::is_defined_var;
array[1..3] of var bool: flags = [b1,b2,b3];
var int: selected;
var int: f1;
var int: f2;
var int: f3;
array[1..3] of var int: forward = [f1,f2,f3];
var int: g1 ::is_defined_var;
var int: g2 ::is_defined_var;
var int: g3 ::is_defined_var;
array[1..3] of var int: backward = [g1,g2,g3];
constraint gecode_sort_permutation(input,sorted,permutation,-2)::defines_var([y3,y1,y2])::checker_constraint("sort",[9007199254740993]);
constraint gecode_sort_permutation(input,sorted,permutation,-2)::defines_var(permutation);
constraint gecode_minimum_arg_int_offset(input,9007199254740993,first_min)::defines_var(first_min);
constraint gecode_arg_min_int(input,9007199254740993,any_min,false)::defines_var(any_min);
constraint array_int_minimum(minimum,input)::defines_var(minimum);
constraint gecode_member_int_reif(input,2,member)::defines_var(member);
constraint gecode_bool_int_channel(flags,selected,9007199254740993)::defines_var(flags);
constraint inverse_offsets(forward,5,backward,10)::defines_var(backward);
solve minimize any_min;
