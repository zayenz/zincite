var int: x;
var int: y;
var int: modulus;
var int: site_a;
var int: site_b;
array[1..2] of var int: sites = [site_a,site_b];
var int: gcd :: is_defined_var;
var int: product :: is_defined_var;
var int: residue :: is_defined_var;
var int: root :: is_defined_var;
var int: minimum :: is_defined_var;
var bool: truth :: is_defined_var;
constraint gecode_gcd_int(x,y,gcd)::defines_var(gcd)::checker_constraint("gcd",[9007199254740993]);
constraint gecode_product_int([x,y],product)::defines_var(product);
constraint gecode_product_mod_var_fzn([x,y],modulus,residue)::defines_var(residue);
constraint gecode_int_nroot(x,3,root)::defines_var(root);
constraint gecode_minimum_distance_required_fzn(sites,2,[0,7,7,0],minimum,[0,7,7,0])::defines_var(minimum);
constraint gecode_divides_int_reif(gcd,x,truth)::defines_var(truth);
constraint gecode_inter_distance_fzn(sites,1);
solve satisfy;
