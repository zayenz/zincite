% Concrete words use exact alphabets and report separate automaton failures.
var int: x ::is_defined_var;
var int: y;
var int: a;
var int: b;
constraint gecode_regular_set([x],1,9007199254740993,9007199254740993,[1],1,{1})::defines_var(x)::"Exact symbol"::checker_constraint("exact_word",[9007199254740993]);
constraint gecode_regular([y],2,2,[2,0,2,1],1,{2})::"DFA word"::checker_constraint("dfa_word",[1]);
constraint gecode_regular_nfa_int_fzn([a,b],3,-1,2,[{1,2},{},{},{3},{},{3}],1,{3})::"NFA word"::checker_constraint("nfa_word",[2,3]);
solve satisfy;
