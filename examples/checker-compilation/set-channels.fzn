var set of int: left :: checker_value("left", [1]);
var set of int: right;
var set of int: selected;
var int: value;
var set of int: combined :: is_defined_var;
var set of int: common :: is_defined_var;
var set of int: bounded_common :: is_defined_var;
var set of int: partitioned :: is_defined_var;
var set of int: image :: is_defined_var;
var bool: flag1 :: is_defined_var;
var bool: flag2 :: is_defined_var;
var bool: flag3 :: is_defined_var;
array [1..3] of var bool: flags = [flag1, flag2, flag3];
var set of int: bucket1 :: is_defined_var;
var set of int: bucket2 :: is_defined_var;
array [1..2] of var set of int: buckets = [bucket1, bucket2];
var set of int: inverse1 :: is_defined_var;
var set of int: inverse2 :: is_defined_var;
array [1..2] of var set of int: inverse = [inverse1, inverse2];
var int: ordered1 :: is_defined_var;
var int: ordered2 :: is_defined_var;
array [1..2] of var int: ordered = [ordered1, ordered2];
constraint gecode_array_set_element_union(selected, [left, right], combined) :: defines_var(combined) :: checker_constraint("selected_union", [9007199254740993]) :: "Selected union";
constraint gecode_array_set_element_intersect(selected, [left, right], common) :: defines_var(common);
constraint gecode_array_set_element_intersect_in(selected, [left, right], bounded_common, 1..3) :: defines_var(bounded_common);
constraint gecode_array_set_element_partition(selected, [left, right], partitioned) :: defines_var(partitioned);
constraint gecode_range([value, 9], 2, {0, 2}, image) :: defines_var(image);
constraint gecode_link_set_to_booleans(combined, flags, 1) :: defines_var(flags);
constraint gecode_int_set_channel([1, 2], 1, buckets, 1) :: defines_var(buckets);
constraint gecode_inverse_set([{4}, {3}], inverse, 1, 3) :: defines_var(inverse);
constraint gecode_set_channel_sorted(ordered, combined) :: defines_var(ordered);
constraint gecode_precede_set([left, right], 1, 3);
solve satisfy;
