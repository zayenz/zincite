var set of int: left;
var set of int: right;
var set of int: selected;
var int: probe;
var set of 1..3: combined :: is_defined_var;
var set of int: hull :: is_defined_var;
var int: total :: is_defined_var;
var int: minimum :: is_defined_var;
var bool: at_maximum :: is_defined_var;
constraint array_set_union([left,right],combined) :: defines_var(combined) :: checker_constraint("union",[1,2]) :: mzn_constraint_name("Combined members");
constraint array_set_partition([left,right],combined) :: checker_constraint("partition",[1,2]);
constraint array_set_seq([left,{},right]) :: checker_constraint("sequence",[1,3]);
constraint gecode_set_convex_hull(selected,hull) :: defines_var(hull);
constraint set_convex(selected) :: checker_constraint("convex",[3]);
constraint gecode_set_atmost_one([left,right],1) :: checker_constraint("cardinality",[1,2]);
constraint gecode_set_weights([9007199254740993,1,3,9007199254740993],[9007199254740993,0,-2,5],selected,total) :: defines_var(total) :: checker_constraint("weights",[9007199254740993]);
constraint gecode_set_min(selected,minimum) :: defines_var(minimum);
constraint gecode_set_max_reif(selected,probe,at_maximum) :: defines_var(at_maximum);
solve minimize total;
