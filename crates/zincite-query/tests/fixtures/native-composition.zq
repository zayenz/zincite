subtree | declarations | unique | project(d, {"name": d | names | one, "uses": d | uses | count});
let matches = match { from d in (subtree | declarations | unique); from u in (d | uses); };
matches;
matches | project(m, {"name": m.d | names | one, "text": m.u | text | one});
let selected = items;
let labels = selected | names;
let n = selected | count;
let rows = [label | label in labels];
let ordered = (rows) | sort | unique;
fn starting_with_a(labels: sequence<string>) -> sequence<string> {
    (labels) | filter(starts_with("a"))
}
let matching = starting_with_a(["ash", "birch", "apple", "ash"]);
let matching_count = (matching) | sort | unique | count;
report (names: ordered, count: n, selected: selected, matching_count: matching_count);
